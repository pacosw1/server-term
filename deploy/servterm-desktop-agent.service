[Unit]
Description=servterm authenticated desktop agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=servterm-desktop
Group=servterm-desktop
EnvironmentFile=/etc/servterm/desktop-agent.env
ExecStart=/usr/local/bin/servterm-desktop-agent --listen ${SERVTERM_LISTEN} --node ${SERVTERM_NODE} --platform ${SERVTERM_PLATFORM} --backend ${SERVTERM_BACKEND} --allow-input --token-file /etc/servterm/desktop-agent.token --vnc-host ${SERVTERM_VNC_HOST} --vnc-port ${SERVTERM_VNC_PORT} --vnc-password-file /etc/servterm/desktop-vnc.password
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
ReadWritePaths=/run/servterm

[Install]
WantedBy=multi-user.target
